# Runtime
NODE_ENV=development
RUNTIME_MODE=development
MARKETPLACE_MODE=single-operator
INFRASTRUCTURE_MODE=cxapp-shared
RUNTIME_LOCATION=host
SHARED_DOCKER_NETWORK=cxapp-network
SHARED_CREDENTIALS_READY=0

# API and portals
API_PORT=7510
WEB_PORT=7520
API_URL=http://127.0.0.1:7510
PUBLIC_URL=http://127.0.0.1:7520
API_BODY_MAX_BYTES=1048576
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
GRAPHQL_QUERY_MAX_BYTES=20000

# Walk-in store
STORE_NAME=CXShop Computer Store
STORE_WHATSAPP=919876543210
STORE_ADDRESS=Configure the store collection address

# OpenAI Business Assist (optional)
OPENAI_ENABLED=0
OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING=low
OPENAI_OUTPUT_MAX_TOKENS=1600

# Development portal switching (never enable in production)
DEV_LOGIN_AUTO=1
DEV_LOGIN_STORE_EMAIL=customer@cxshop.local
DEV_LOGIN_VENDOR_EMAIL=vendor@cxshop.local
DEV_LOGIN_ADMIN_EMAIL=admin@cxshop.local
DEV_LOGIN_SA_EMAIL=sa@cxshop.local

# MariaDB
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=cxshop
DB_PASSWORD=change-local-database-password
DB_NAME=cxshop_db

# Redis and durable jobs
REDIS_URL=redis://:change-shared-redis-password@127.0.0.1:6379/2
REDIS_PREFIX=cxshop:
QUEUE_BACKEND=database
QUEUE_WORKER_ENABLED=1
QUEUE_POLL_MS=1000
QUEUE_MAX_ATTEMPTS=5

# Local and object storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:7590
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=cxshop-dev
OBJECT_STORAGE_ACCESS_KEY=change-local-storage-access-key
OBJECT_STORAGE_SECRET_KEY=change-local-storage-secret-key
OBJECT_STORAGE_PATH_STYLE=1
MEDIA_DRIVER=shared-filebrowser
FILEBROWSER_URL=http://127.0.0.1:7090
SHARED_MEDIA_VOLUME=cxapp-media-data
SHARED_MEDIA_ROOT=/srv/cxshop

# Browser sessions
LOGIN_SECRET=replace-with-at-least-32-random-characters
LOGIN_SESSION_HOURS=168
LOGIN_RENEWAL_HOURS=24
LOGIN_COOKIE_NAME=cxshop_session
LOGIN_COOKIE_SECURE=0
LOGIN_COOKIE_SAME_SITE=strict
DEV_LOGIN_PASSWORD=replace-with-a-strong-development-password

# Search, payments, mail, and observability
SEARCH_DRIVER=database
PAYMENT_DRIVER=manual
MAIL_DRIVER=console
LOG_LEVEL=info
OTEL_ENABLED=0

# Optional CXApp connector
CXAPP_ENABLED=0
CXAPP_BASE_URL=
CXAPP_CLIENT_ID=
CXAPP_CLIENT_SECRET=
CXAPP_WEBHOOK_SECRET=

# Optional Frappe connector
FRAPPE_ENABLED=0
FRAPPE_BASE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=
FRAPPE_WEBHOOK_SECRET=

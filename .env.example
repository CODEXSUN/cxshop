# === Runtime ===
NODE_ENV=development
PLATFORM_API_PORT=7010
PLATFORM_WEB_PORT=7020
PLATFORM_WEB_ORIGIN=http://app.codexsun.test

# === Database connection ===
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_MASTER_NAME=

# === File Manager ===
# File Manager owns fm_* tables and reuses CXShop's MariaDB connection.
FILE_MANAGER_DB_HOST=127.0.0.1
FILE_MANAGER_DB_PORT=3306
FILE_MANAGER_DB_USER=
FILE_MANAGER_DB_PASSWORD=
FILE_MANAGER_DB_NAME=
FILE_MANAGER_ENCRYPTION_KEY=
FILE_MANAGER_LOCAL_ROOT=storage/app/file-manager
FILE_MANAGER_MAX_UPLOAD_BYTES=26214400

# --- Database lifecycle ---
# CXSHOP_DB_FRESH_ON_START=1 drops and rebuilds configured databases on API startup.
# Destructive actions require CXSHOP_DB_RESET_CONFIRM=DROP_DATABASES.
# Production additionally requires CXSHOP_ALLOW_PRODUCTION_DB_RESET=1.
CXSHOP_DB_FRESH_ON_START=0
CXSHOP_DB_RESET_CONFIRM=
CXSHOP_ALLOW_PRODUCTION_DB_RESET=0

# --- Database maintenance and backup/restore ---
CXSHOP_BACKUP_DIR=storage/backups/database
CXSHOP_RESTORE_TEST_DB_NAME=
CXSHOP_VERIFIED_BACKUP_ID=
CXSHOP_ALLOW_LIVE_RESTORE=0
CXSHOP_LIVE_RESTORE_CONFIRM=

# === Queue ===
# MariaDB is the durable baseline. bullmq-redis is an optional delivery accelerator;
# queue state and recovery remain in MariaDB.
CXSHOP_QUEUE_BACKEND=database
CXSHOP_REDIS_URL=redis://127.0.0.1:6379

# === Mail ===
# Default Mail fallback. Tenant company settings take priority when enabled.
MAIL_ENABLED=0
MAIL_SMTP_HOST=
# Use 465 with MAIL_SMTP_SECURE=1, or 587 with MAIL_SMTP_SECURE=0 for STARTTLS.
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CODEXSUN
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
CXSHOP_QUEUE_WORKER_ENABLED=1
CXSHOP_QUEUE_WORKER_INTERVAL_MS=5000
CXSHOP_QUEUE_COMPLETED_RETENTION_DAYS=14
CXSHOP_QUEUE_FAILED_RETENTION_DAYS=30

# === Default tenant ===
# Test-only default first tenant seed. Keep disabled for normal/live runtime.
# Set ENABLE_DEFAULT_TENANT_SEED=1 only for local smoke tests or e2e runs.
ENABLE_DEFAULT_TENANT_SEED=1
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=localhost
DEFAULT_TENANT_NAME=CODEXSUN
DEFAULT_TENANT_CORPORATE_ID=
DEFAULT_TENANT_SLUG=
DEFAULT_TENANT_DB_NAME=
DEFAULT_TENANT_DOMAIN=app.codexsun.test
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# === Authentication and sessions ===
# REQUIRED. No fallback.
JWT_SECRET=

# === WhiteBooks GST provider ===
# Keep all credentials server-side; never expose them as VITE_* values.
GSP_ENVIRONMENT=sandbox
GSP_SANDBOX_BASE_URL=https://apisandbox.whitebooks.in
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_GSTIN=
GSP_IP_ADDRESS=0.0.0.0

# Hybrid keeps browser sessions in an HttpOnly cookie while retaining bearer JWTs for API clients.
AUTH_MODE=hybrid
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_RENEWAL_HOURS=24

# === Bootstrap users ===
# Optional first platform users. Leave blank on live and create users
# manually unless this deployment intentionally needs a seeded account.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

# --- Tenant administrator bootstrap ---
# Optional tenant setup helper account. Leave blank on live unless you
# intentionally want every newly setup tenant to receive this admin user.
TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# === Storage ===
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public
# Optional one-time import path for legacy Task Manager JSON files. Runtime writes use MariaDB.
TASK_MANAGER_JSON_DIR=storage/app/task-manager

# === Development and tooling ===
# Set to "abort" to prevent the dev preflight from killing active listeners.
# CXSHOP_DEV_PORT_POLICY=abort

# Set to 1 for faster local restarts when the database is already prepared.
# Skips the API database preflight and startup database bootstrap.
CXSHOP_DEV_SKIP_DB=0

# Database safety command guards.
# Required for npm run db:migrations:test-local after restoring a dump locally.
CXSHOP_RESTORED_DUMP_TEST=0

# Required for npm run db:backup:verify.
CXSHOP_BACKUP_VERIFY_ID=
CXSHOP_DATA_SOURCE=own
CXSHOP_FRAPPE_URL=
CXSHOP_FRAPPE_API_KEY=
CXSHOP_FRAPPE_API_SECRET=
CXSHOP_ENV_FILE_PATH=
# Honey AI: openai, openrouter, or opencode. Keep API keys outside source control.
CXSHOP_AI_PROVIDER=openai
CXSHOP_AI_API_KEY=
CXSHOP_AI_BASE_URL=
CXSHOP_AI_MODEL=gpt-5.6-terra

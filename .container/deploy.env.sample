# === Production runtime ===
NODE_ENV=production
PLATFORM_API_PORT=18010
PLATFORM_WEB_PORT=18020
PLATFORM_WEB_ORIGIN=http://127.0.0.1:18020

# === Container database connection ===
DB_DRIVER=mariadb
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_USER=cxshop
DB_PASSWORD=change_this_database_password
DB_MASTER_NAME=cxshop_db

# === File Manager ===
FILE_MANAGER_DB_HOST=cxapp-mariadb
FILE_MANAGER_DB_PORT=3306
FILE_MANAGER_DB_USER=cxshop
FILE_MANAGER_DB_PASSWORD=change_this_database_password
FILE_MANAGER_DB_NAME=cxshop_db
FILE_MANAGER_ENCRYPTION_KEY=change_this_file_manager_encryption_key
FILE_MANAGER_LOCAL_ROOT=/storage/app/file-manager
FILE_MANAGER_MAX_UPLOAD_BYTES=26214400

# --- Database lifecycle ---
CXSHOP_DB_FRESH_ON_START=0
CXSHOP_DB_RESET_CONFIRM=
CXSHOP_ALLOW_PRODUCTION_DB_RESET=0

# --- Database maintenance and backup/restore ---
CXSHOP_BACKUP_DIR=storage/backups/database
CXSHOP_RESTORE_TEST_DB_NAME=
CXSHOP_VERIFIED_BACKUP_ID=change_this_verified_backup_id
CXSHOP_ALLOW_LIVE_RESTORE=0
CXSHOP_LIVE_RESTORE_CONFIRM=

# === Queue and Redis ===
CXSHOP_QUEUE_BACKEND=database
CXSHOP_REDIS_URL=redis://:change_this_redis_password@cxapp-redis:6379/2

# === Application data source ===
CXSHOP_DATA_SOURCE=own
# Use host.docker.internal for a Frappe service published on the Docker host.
CXSHOP_FRAPPE_URL=
CXSHOP_FRAPPE_API_KEY=
CXSHOP_FRAPPE_API_SECRET=

# Honey AI model connection. API keys stay in the deployment environment.
CXSHOP_AI_PROVIDER=openai
CXSHOP_AI_API_KEY=
CXSHOP_AI_BASE_URL=
CXSHOP_AI_MODEL=gpt-5.6-terra

# === Mail fallback ===
MAIL_ENABLED=0
MAIL_SMTP_HOST=
# Use 465 with MAIL_SMTP_SECURE=1, or 587 with MAIL_SMTP_SECURE=0 for STARTTLS.
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CODEXSUN
MAIL_REPLY_TO=
PASSWORD_RESET_TTL_MINUTES=30
CXSHOP_QUEUE_WORKER_ENABLED=1
CXSHOP_QUEUE_WORKER_INTERVAL_MS=5000
CXSHOP_QUEUE_COMPLETED_RETENTION_DAYS=14
CXSHOP_QUEUE_FAILED_RETENTION_DAYS=30

# === Default tenant ===
ENABLE_DEFAULT_TENANT_SEED=1
DEV_AUTO_TENANT_LOGIN=0
TENANT_DOMAIN_BASE=codexsun.com
DEFAULT_TENANT_NAME=CODEXSUN
DEFAULT_TENANT_CORPORATE_ID=CODEXSUN
DEFAULT_TENANT_SLUG=codexsun
DEFAULT_TENANT_DB_NAME=cxshop_db
DEFAULT_TENANT_DOMAIN=app.codexsun.com
DEFAULT_TENANT_ADMIN_NAME=
DEFAULT_TENANT_ADMIN_EMAIL=
DEFAULT_TENANT_ADMIN_PASSWORD=

# === Authentication and sessions ===
JWT_SECRET=change_this_jwt_secret
AUTH_MODE=hybrid
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_RENEWAL_HOURS=24

# === WhiteBooks GST provider ===
GSP_ENVIRONMENT=sandbox
GSP_SANDBOX_BASE_URL=https://apisandbox.whitebooks.in
GSP_BASE_URL=https://api.whitebooks.in
GSP_EMAIL=
GSP_USERNAME=
GSP_PASSWORD=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_GSTIN=
GSP_IP_ADDRESS=0.0.0.0

# === Bootstrap users ===
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

SOFTWARE_ADMIN_NAME=
SOFTWARE_ADMIN_EMAIL=
SOFTWARE_ADMIN_PASSWORD=

TENANT_ADMIN_NAME=
TENANT_ADMIN_EMAIL=
TENANT_ADMIN_PASSWORD=

# === Container storage paths ===
STORAGE_ROOT=storage/app
STORAGE_PUBLIC_ROOT=storage/public
TASK_MANAGER_JSON_DIR=storage/app/task-manager
CXSHOP_DEVKIT_STORAGE_PATH=storage/app/devkit
CXSHOP_DEVKIT_SYNC_ROLE=disabled
CXSHOP_DEVKIT_SYNC_INSTANCE_ID=
CXSHOP_DEVKIT_SYNC_TOKEN_PEPPER=
CXSHOP_DEVKIT_SYNC_ENCRYPTION_KEY=
CXSHOP_DEVKIT_SYNC_TEST_CLOUD_URL=
CXSHOP_DEVKIT_WORKSPACE_ROOT=

# === Database tooling guards ===
CXSHOP_DEV_SKIP_DB=0
CXSHOP_RESTORED_DUMP_TEST=0
CXSHOP_BACKUP_VERIFY_ID=

# === Deployment images and network ===
NODE_RUNTIME_VERSION=26.5.0
NPM_RUNTIME_VERSION=12.0.1
NGINX_BASE_IMAGE=nginx:1.28-alpine
CXSHOP_VERSION=1.0.66
CXSHOP_IMAGE_REGISTRY=cxshop
CXSHOP_DOCKER_NETWORK=cxapp-network
CXSHOP_BIND_ADDRESS=127.0.0.1
CXSHOP_SINGLE_TENANT=1
CXSHOP_SHARED_MARIADB_CONTAINER=cxapp-mariadb
CXSHOP_SHARED_MARIADB_PROJECT=cxapp-mariadb
CXSHOP_SHARED_MARIADB_SERVICE=mariadb
CXSHOP_SHARED_REDIS_CONTAINER=cxapp-redis
CXSHOP_SHARED_REDIS_PROJECT=cxapp-redis
CXSHOP_SHARED_REDIS_SERVICE=redis
CXSHOP_SHARED_MEDIA_CONTAINER=cxapp-media
CXSHOP_SHARED_MEDIA_PROJECT=cxapp-media
CXSHOP_SHARED_MEDIA_SERVICE=media
CXSHOP_RUNTIME_ENV_MODE=ro
CXSHOP_ENV_FILE_PATH=/app/.env
CXSHOP_PIKO_CODEX_HOME=/app/.codex
CXSHOP_CODEX_DATA_VOLUME=cxshop-codex-data

# === Guarded application updates ===
# Must match the source version after this release's migrations are reviewed as
# expand-contract and backward-compatible with the currently running image.
CXSHOP_MIGRATION_COMPATIBLE_VERSION=1.0.66
CXSHOP_UPDATE_BACKUP_RETENTION=10
CXSHOP_UPDATE_MIN_BACKUP_FREE_MB=1024
CXSHOP_UPDATE_MIN_DOCKER_FREE_MB=5120

# === MariaDB container ===
MARIADB_BASE_IMAGE=mariadb:11.8
MARIADB_IMAGE_TAG=11.8-cxshop-1.0.66
MARIADB_CLIENT_PATH=mariadb
MARIADB_ADMIN_USER=root
MARIADB_ROOT_PASSWORD=change_this_mariadb_root_password
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_HOST_PORT=3307
MARIADB_DATA_VOLUME=cxshop-mariadb-data
MARIADB_BACKUP_VOLUME=cxshop-mariadb-backups

# === Redis container ===
REDIS_BASE_IMAGE=redis:7.4-alpine
REDIS_IMAGE_TAG=7.4-cxshop-1.0.45
REDIS_PASSWORD=change_this_redis_password
REDIS_HOST_PORT=6379
REDIS_DATA_VOLUME=cxshop-redis-data

# === File Browser container ===
FILEBROWSER_BASE_IMAGE=filebrowser/filebrowser:v2.63.5
MEDIA_IMAGE_TAG=1.0.66-filebrowser2.63.5
MEDIA_HOST_PORT=7090
MEDIA_ADMIN_USER=admin
MEDIA_ADMIN_PASSWORD=change_this_media_admin_password
MEDIA_DATA_VOLUME=cxapp-media-data
MEDIA_DB_VOLUME=cxapp-media-db

# === Application images and storage ===
BILLING_STACK_API_IMAGE_TAG=1.0.66
BILLING_STACK_WEB_IMAGE_TAG=1.0.66
BILLING_STACK_MIGRATIONS_IMAGE_TAG=1.0.66
BILLING_STACK_DATA_VOLUME=cxshop-billing-stack-data

# === Public deployment hosts ===
CXSHOP_WEB_HOST=app.codexsun.com
CXSHOP_WEB_HOST_ALT=www.codexsun.com
CXSHOP_MEDIA_HOST=files.codexsun.com

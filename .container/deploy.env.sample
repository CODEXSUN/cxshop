NODE_ENV=production
APP_VERSION=1.1.1
IMAGE_REGISTRY=local/cxshop
DOCKER_NETWORK=cxapp-network
INFRASTRUCTURE_MODE=cxapp-shared
RUNTIME_LOCATION=container
SHARED_DOCKER_NETWORK=cxapp-network
SHARED_CREDENTIALS_READY=0
BIND_ADDRESS=127.0.0.1
API_PORT=7510
WEB_PORT=7520
CUSTOMER_HOST=shop.example.com
VENDOR_HOST=vendor.shop.example.com
PLATFORM_HOST=admin.shop.example.com
DB_DRIVER=mariadb
DB_HOST=cxapp-mariadb
DB_PORT=3306
DB_NAME=cxshop_db
DB_USER=cxshop
DB_PASSWORD=change-database-password
REDIS_URL=redis://:change-shared-redis-password@cxapp-redis:6379/2
REDIS_PREFIX=cxshop:
OBJECT_STORAGE_ENDPOINT=http://cxshop-storage:9000
OBJECT_STORAGE_BUCKET=cxshop
OBJECT_STORAGE_ACCESS_KEY=change-storage-access-key
OBJECT_STORAGE_SECRET_KEY=change-storage-secret-key
MEDIA_DRIVER=shared-filebrowser
FILEBROWSER_URL=http://cxapp-media
SHARED_MEDIA_VOLUME=cxapp-media-data
SHARED_MEDIA_ROOT=/srv/cxshop
RUNTIME_COMPOSE=.container/runtime/docker-compose.yml
